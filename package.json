{
  "name": "bible-display",
  "productName": "BibleDisplay",
  "version": "0.1.5",
  "private": true,
  "description": "Show Bible verses on a second monitor",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "import-kjv": "esbuild data/import-kjv.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=out/import-kjv.cjs && cross-env ELECTRON_RUN_AS_NODE=1 electron out/import-kjv.cjs",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm version patch --no-git-tag-version && npm run build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "font-list": "^2.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.local.bibledisplay",
    "productName": "BibleDisplay",
    "directories": {
      "output": "release"
    },
    "files": [
      "!**/.vscode/*",
      "!{src,data,tests,docs,resources,.superpowers,release}/**",
      "!{tsconfig.json,electron.vite.config.ts,vitest.config.ts,README.md}"
    ],
    "extraResources": [
      {
        "from": "resources/bible.db",
        "to": "bible.db"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
